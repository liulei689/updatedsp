<UserControl x:Class="WpfApp3D.demo3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3D"
             xmlns:ht="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        d:DesignHeight="850" d:DesignWidth="1300" Loaded="Window_Loaded">
     <!--Title="机械臂"-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1">
        <ht:HelixViewport3D x:Name="htVp" ShowCoordinateSystem="True" ShowViewCube="False" Width="1000" Height="850" >
            <!--相机-->
            <ht:HelixViewport3D.Camera> 
                <PerspectiveCamera Position="100,100,100" LookDirection="-100,-100,-100" UpDirection="0,0,1" FieldOfView="80"/>
            </ht:HelixViewport3D.Camera>
            <ht:SunLight/>
        </ht:HelixViewport3D>

        <Viewport3D Name="viewport">
            <!--相机-->
            <Viewport3D.Camera>
                <PerspectiveCamera Position="100,100,100"
                                   LookDirection="-100,-100,-100"
                                   UpDirection="0,0,1"
                                   FieldOfView="5">
                    <PerspectiveCamera.Transform>
                        <RotateTransform3D CenterX="0" CenterY="0" CenterZ="0">
                            <RotateTransform3D.Rotation>
                                <!--相机沿X 轴的点 旋转40度-->
                                <AxisAngleRotation3D Axis="0,0,1" Angle="40"></AxisAngleRotation3D>
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                        
                    </PerspectiveCamera.Transform>
                </PerspectiveCamera>
            </Viewport3D.Camera>
            <!--光源-->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <!--环境光：提亮整体的环境亮度-->
                        <AmbientLight Color="#999"/>
                        <!--点光源 光影层次感-->
                        <PointLight Color="#DDD" Position="100,0,100" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
                
            </ModelVisual3D>            
        </Viewport3D>
        </StackPanel>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="轴1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="轴2" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1"/>
            <TextBlock Text="轴3" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2"/>
            <TextBlock Text="轴4" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="3"/>
            <TextBlock Text="轴5" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="4"/>
            <TextBlock Text="轴6" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="5"/>

            <Slider Minimum="-360" Maximum="360" Value="0" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Tag="1" ValueChanged="Slider_ValueChanged"></Slider>
            <Slider Minimum="-50" Maximum="50" Value="0" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Tag="2" ValueChanged="Slider_ValueChanged"></Slider>
            <Slider Minimum="-50" Maximum="50" Value="0" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Tag="3" ValueChanged="Slider_ValueChanged"></Slider>
            <Slider Minimum="-50" Maximum="50" Value="0" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Tag="4" ValueChanged="Slider_ValueChanged"></Slider>
            <Slider Minimum="-180" Maximum="180" Value="0" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Tag="5" ValueChanged="Slider_ValueChanged"></Slider>
            <Slider Minimum="-40" Maximum="40" Value="0" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Tag="6" ValueChanged="Slider_ValueChanged"></Slider>
            
        </Grid>
    </Grid>
</UserControl>
