<Window x:Class="WpfApp3D.WaveformChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        WindowStartupLocation="CenterScreen"
        Title="系统" >
    <Grid  >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="1">
            <StackPanel  Orientation="Horizontal" Margin="1" >
                <Label Content="显示/隐藏波形：" Margin="-5"/>
                <CheckBox x:Name="l1" Content="波形1" IsChecked="True" Checked="Wave_Checked" Unchecked="Wave_Unchecked">
                </CheckBox>
                <CheckBox x:Name="l2" Content="波形2" IsChecked="True" Checked="Wave_Checked" Unchecked="Wave_Unchecked">
                </CheckBox>
                <CheckBox x:Name="l3" Content="波形3" IsChecked="True" Checked="Wave_Checked" Unchecked="Wave_Unchecked">
                </CheckBox>
                <CheckBox x:Name="l4" Content="波形4" IsChecked="True" Checked="Wave_Checked" Unchecked="Wave_Unchecked">
                </CheckBox>
                <CheckBox x:Name="l5" Content="波形5" IsChecked="True" Checked="Wave_Checked" Unchecked="Wave_Unchecked">
                </CheckBox>
                <CheckBox x:Name="l6" Content="波形6" IsChecked="True" Checked="Wave_Checked" Unchecked="Wave_Unchecked">
                </CheckBox>
                <Button  Content="只显示横滚" Width="80" Click="Button_Click" Margin="5,0,0,0"  Foreground="Green"  BorderBrush="Transparent" />
                <Button  Content="只显示俯仰" Width="80" Click="Button_Click" Margin="5,0,0,0"  Foreground="Green" BorderBrush="Transparent"/>
                <Button  Content="全部显示" Width="60" Click="Button_Click" Margin="5,0,0,0"  Foreground="Green"  BorderBrush="Transparent" />
                <Button  Content="全部隐藏" Width="60" Click="Button_Click" Margin="5,0,0,0"  Foreground="Green"  BorderBrush="Transparent" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="操作：" Margin="-5"/>
                <Button x:Name="st" Content="暂停" Width="60" Click="Button_Click_1" Margin="5,0,0,0"  Foreground="Green"  BorderBrush="Transparent" />
            </StackPanel>
        </StackPanel>
        <Border  BorderBrush="LightGray" Grid.Row="0"  MinHeight="400"   BorderThickness="1"   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Background="Transparent" >
            <lvc:CartesianChart Name="cartesianChart" Series="{Binding SeriesCollection}"  DisableAnimations="True">
          
            </lvc:CartesianChart>


        </Border>
     
    </Grid>
</Window>
