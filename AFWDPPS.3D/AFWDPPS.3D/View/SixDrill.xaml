<UserControl x:Class="WpfApp3D.SixDrill"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3D"
             xmlns:ht="http://helix-toolkit.org/wpf"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
         d:DesignHeight="450" d:DesignWidth="800" Loaded="Window_Loaded">
    <Grid>
       
        <ht:HelixViewport3D Name="vp" 
                     ShowViewCube="True"
                     ShowCoordinateSystem="True">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseLeftButtonDown">
                    <!--TargetObject 目标对象-->
                    <b:CallMethodAction TargetObject="{Binding}"
                                 MethodName="vp_MouseLeftButtonDown"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <ht:HelixViewport3D.Camera>
                <!--Position 相机位置 LookDirection 视角方向的  UpDirection 相机向上方向-->
                <!--<PerspectiveCamera Position="-10,-10,-10" LookDirection="-100,-50,50" UpDirection="0,0,6" FieldOfView="120"/>-->
                <PerspectiveCamera Position="450,-350,200" LookDirection="-150,100,-50" UpDirection="0,0,1" FieldOfView="80"/>
                <!--<PerspectiveCamera
             Position="2333.157143728179,790.6064884526568,3366.080088587602"
             LookDirection="-2709.824751353727,-1270.1423118225575,-2985.1379658866217"
             UpDirection="-0.49363898657731986,0.7182941542504749,-0.490279572183607"
             FieldOfView="10" />-->
            </ht:HelixViewport3D.Camera>
            <!--光源-->
            <!--<ht:DefaultLights/>-->
            <ht:SunLight/>

            <!--<ht:GridLinesVisual3D Width="10000" Length="10000"
                           MajorDistance="200" MinorDistance="50"
                           Thickness="1" Fill="#2000"
                           Normal="0,1,0" />-->

            <!--可以使用绑定的方式，但是不直接绑定，可以使用附加属性进行绑定-->


            <ModelUIElement3D>
                <ModelUIElement3D.Model>
                    <Model3DGroup>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D></MeshGeometry3D>
                            </GeometryModel3D.Geometry>
                        </GeometryModel3D>

                        <GeometryModel3D></GeometryModel3D>

                        <GeometryModel3D></GeometryModel3D>

                        <GeometryModel3D></GeometryModel3D>
                    </Model3DGroup>
                </ModelUIElement3D.Model>
            </ModelUIElement3D>
        </ht:HelixViewport3D>
    </Grid>
</UserControl>
