<Window x:Class="WpfApp3D.View.MoliD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3D.View"
        mc:Ignorable="d"
        Title="MoliD" Height="450" Width="800">

    <Grid Grid.Row="0" Grid.Column="2" Margin="10,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 串口号 -->
            <RowDefinition Height="Auto"/>
            <!-- 波特率 -->
            <RowDefinition Height="Auto"/>
            <!-- 打开按钮 -->
            <RowDefinition Height="20"/>
            <!-- 分隔 -->
            <RowDefinition Height="Auto"/>
            <!-- 串口号2 -->
            <RowDefinition Height="Auto"/>
            <!-- 波特率2 -->
            <RowDefinition Height="Auto"/>
            <!-- 打开按钮2 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 第一组串口 -->
        <TextBlock Text="串口号:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="comlist1" Grid.Row="0" Grid.Column="1" Margin="10,5,0,5"/>

        <TextBlock Text="波特率:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="botelv1" Grid.Row="1" Grid.Column="1" Margin="10,5,0,5"/>

        <ToggleButton Name="openclosecom1" Grid.Row="2" Grid.ColumnSpan="2" Height="25" Margin="0,5"
                  Content="打开稳定平台串口" IsChecked="False" />

        <!-- 第二组串口 -->
        <TextBlock Text="串口号:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="comlist2" Grid.Row="4" Grid.Column="1" Margin="10,5,0,5"/>

        <TextBlock Text="波特率:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="botelv2"  Grid.Row="5" Grid.Column="1" Margin="10,5,0,5"/>

        <ToggleButton Name="openclosecom2" Grid.Row="6" Grid.ColumnSpan="2" Height="25" Margin="0,5"
                  Content="打开平台MU串口" IsChecked="False" />
    </Grid>
</Window>
