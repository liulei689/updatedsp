<Window x:Class="WpfApp3D.View.BoXing"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"    
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"    xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Title="多通道实时波形" Height="600" Width="1000">
    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Back"
                                Width="40" Height="20"
                                CornerRadius="10"
                                Background="#FFCCCCCC"/>
                            <Border x:Name="Slider"
                                Width="16" Height="16"
                                CornerRadius="8"
                                HorizontalAlignment="Left"
                                Margin="2,0,0,0"
                                Background="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back"  Property="Background" Value="#FF0078D4"/>
                                <Setter TargetName="Slider" Property="Margin" Value="22,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0" VerticalAlignment="Center" >
            <TextBlock Text="显示通道：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <CheckBox x:Name="cb1" Content="船体横滚" IsChecked="True" Margin="0,0,8,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb2" Content="声呐横滚" IsChecked="True" Margin="0,0,8,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb3" Content="电机横滚动作" IsChecked="True" Margin="0,0,8,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb4" Content="船体俯仰" IsChecked="True" Margin="0,0,8,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb5" Content="声呐俯仰" IsChecked="True" Margin="0,0,8,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb6" Content="电机俯仰动作" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb7" Content="陀螺横摇角速度" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb8" Content="陀螺俯仰角速度" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb9" Content="陀螺横摇角速度积分" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb10" Content="陀螺俯仰角速度积分" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb11" Content="横摇电流" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>
            <CheckBox x:Name="cb12" Content="俯仰电流" IsChecked="True" Margin="0,0,16,0" Checked="ChannelCheckBoxChanged" Unchecked="ChannelCheckBoxChanged"/>

            <TextBlock Text="点数：" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PointCountCombo" Width="80" SelectionChanged="PointCountCombo_SelectionChanged">
                <ComboBoxItem Content="100" />
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="1000" IsSelected="True" />
                <ComboBoxItem Content="2000"/>
                <ComboBoxItem Content="3000"/>
                <ComboBoxItem Content="10000"/>
            </ComboBox>
            <Label Content="波形自适应(关闭后可手动调整)" />
            <ToggleButton x:Name="AutoScaleToggle"
              Content="波形自适应" IsChecked="True"
                Checked="AutoScaleToggle_Checked"
                Unchecked="AutoScaleToggle_Checked"
              Style="{StaticResource ToggleSwitch}"
              HorizontalAlignment="Left"
              VerticalAlignment="Top" Margin="0,0,8,0"
               />
        </StackPanel>
        <wpf:WpfPlot x:Name="WpfPlot1" Grid.Row="1" Margin="10"/>
    </Grid>
</Window>
