<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net472</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>rubyer.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Authors>Ensin</Authors>
		<Version>2.9.3</Version>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Style\**" />
		<EmbeddedResource Remove="Style\**" />
		<None Remove="Style\**" />
		<Page Remove="Style\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="ViewModels\TreeViewViewModel.cs" />
	  <Compile Remove="Views\TreeViewDemo.xaml.cs" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="weather.json" />
	</ItemGroup>

	<ItemGroup>
	  <Page Remove="Views\TreeViewDemo.xaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Costura.Fody" Version="5.8.0-alpha0098">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="HandyControl" Version="3.5.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
		<PackageReference Include="Rubyer" Version="2.15.21" />
		<PackageReference Include="VirtualizingWrapPanel" Version="2.0.10" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
		<Reference Include="System.ComponentModel.DataAnnotations" />
		<PackageReference Include="System.Text.Json" Version="9.0.0-preview.7.24405.7" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="System.Management" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="rubyer.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<Page Update="Views\About.xaml">
			<XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
		</Page>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Assets\" />
	  <Folder Include="Enums\" />
	  <Folder Include="Models\" />
	</ItemGroup>

	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>
</Project>