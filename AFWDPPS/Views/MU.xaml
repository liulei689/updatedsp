<UserControl x:Class="AFWDPP.Views.MU"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rubyer="http://rubyer.io/winfx/xaml/toolkit"
             xmlns:usercontrols="clr-namespace:导引头上位机程序.Views.UserControls"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
        <Grid Margin="5"
              rubyer:GridHelper.RowDefinitions="Auto, Auto, Auto, *"
              rubyer:PanelHelper.Spacing="10">

            <!-- Row 0: 串口配置组（普通 Grid 布局，不用 DescriptionItem 撑大开关） -->
            <GroupBox Grid.Row="0" Header="MU 串口配置（422 全双工）">
                <Grid Margin="5" rubyer:GridHelper.RowDefinitions="Auto,Auto,Auto">
                    <!-- 串口参数行 -->
                    <Grid Grid.Row="0" rubyer:GridHelper.ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="串口号:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="comlist" MinWidth="80" Margin="5 0"/>
                        <Button Grid.Column="2" Style="{StaticResource TextButton}"
                                rubyer:ButtonHelper.Shape="Circle" Margin="2 0 0 0"
                                Click="refreshComList_Click" Cursor="Hand" ToolTip="刷新串口列表"
                                Width="60">
                            <rubyer:Icon Type="RefreshLine"/>
                        </Button>
                        <TextBlock Grid.Column="3" Text="波特率:" VerticalAlignment="Center" Margin="10 0 0 0"/>
                        <ComboBox Grid.Column="4" x:Name="botelv" MinWidth="80" Margin="5 0"/>
                        <ToggleButton Grid.Column="5" x:Name="openclosecom"
                                      Style="{DynamicResource SwitchToggleButton}" Margin="10 0 0 0"
                                      Click="openclosecom_Click">
                            <StackPanel Orientation="Horizontal">
                                <rubyer:Icon Type="WifiOffFill"/>
                                <TextBlock Margin="5 0 0 0" Text="串口未连接"/>
                            </StackPanel>
                            <rubyer:ToggleButtonHelper.CheckedContent>
                                <StackPanel Orientation="Horizontal">
                                    <rubyer:Icon Type="WifiFill" Foreground="{StaticResource Success}"/>
                                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource Success}" Text="串口已连接"/>
                                </StackPanel>
                            </rubyer:ToggleButtonHelper.CheckedContent>
                        </ToggleButton>
                        <rubyer:Loading Grid.Column="6" x:Name="rx" Style="{StaticResource WaveLoading}"
                                        Margin="10 0 0 0" FontSize="8" Content="接收" IsEnabled="False"/>
                        <rubyer:Loading Grid.Column="7" x:Name="tx" Style="{StaticResource WaveLoading}"
                                        Margin="10 0 0 0" FontSize="8" Content="发送"
                                        FocusedBrush="{DynamicResource Success}" IsEnabled="False"/>
                    </Grid>

                    <!-- 离线策略行（用 CheckBox，不用 SwitchToggleButton 防止被拉大） -->
                    <Grid Grid.Row="1" Margin="0 5 0 0"
                          rubyer:GridHelper.ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
                        <TextBlock Grid.Column="0" Text="MU 离线时船姿字段:" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="offlinePolicy" Margin="5 0 0 0" IsChecked="True"
                                  VerticalAlignment="Center" Cursor="Hand"
                                  ToolTip="勾选=MU 离线时船姿字段 [6-9] 填 0；不勾选=保持上一组值"
                                  Click="offlinePolicy_Click"/>
                        <TextBlock Grid.Column="2" x:Name="offlinePolicyHint" Margin="10 0 0 0"
                                   VerticalAlignment="Center" Foreground="#FFDB3340"
                                   Text="填 0"/>
                        <TextBlock Grid.Column="3" Text="|" Margin="20 0" VerticalAlignment="Center" Foreground="#888"/>
                        <TextBlock Grid.Column="4" Text="MU 离线时不刷新接受组件，节约性能"
                                   VerticalAlignment="Center" Foreground="#888"/>
                    </Grid>

                    <!-- 日志清理行（同样用 CheckBox） -->
                    <Grid Grid.Row="2" Margin="0 5 0 0"
                          rubyer:GridHelper.ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                        <TextBlock Grid.Column="0" Text="数据显示:" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="rxtxshow" Margin="5 0 0 0" IsChecked="True"
                                  VerticalAlignment="Center" Cursor="Hand"
                                  ToolTip="关闭则不再向接受列表写入数据，节约性能"
                                  Click="rxtxshow_Click"/>
                        <TextBlock Grid.Column="2" Text="|" Margin="20 0" VerticalAlignment="Center" Foreground="#888"/>
                        <Button Grid.Column="3" Style="{StaticResource TextButton}"
                                rubyer:ButtonHelper.Shape="Circle" Margin="10 0 0 0"
                                Click="clearLogs_Click" Cursor="Hand" ToolTip="清空接收日志"
                                Width="80" Content="清空">
                        </Button>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Row 1: MU 实时解析数据（普通 Grid 布局，6 个 item 一行 2 个） -->
            <GroupBox Grid.Row="1" Header="MU 实时解析数据">
                <Grid Margin="5" rubyer:GridHelper.RowDefinitions="Auto,Auto,Auto"
                      rubyer:GridHelper.ColumnDefinitions="Auto,*,Auto,*">
                    <!-- 第 1 行：船横摇 + 船俯仰 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="船横摇角度(pitch):" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="pitchLabel" Text="—" Margin="5 0 20 0"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="船俯仰角度(yaw):" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="yawLabel" Text="—" Margin="5 0"/>

                    <!-- 第 2 行：接收帧数 + 最后更新时间 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="接收帧数:" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="frameCountLabel" Text="0" Margin="5 0 20 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="最后更新时间:" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="lastUpdateLabel" Text="—" Margin="5 0"/>

                    <!-- 第 3 行：连接状态 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="连接状态:" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="statusLabel" Text="串口未打开" Margin="5 0"/>
                </Grid>
            </GroupBox>

            <!-- Row 2: 数据显示开关指示（小条，不占空间） -->
            <TextBlock Grid.Row="2" Text="数据显示（关闭后停止接收列表写入）" Foreground="#888"/>

            <!-- Row 3: 数据显示（发送 + 接受），* 自适应填满 -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="发送" Margin="1">
                    <usercontrols:RunDataListViewer x:Name="txlog"/>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="接受" Margin="1">
                    <usercontrols:RunDataListViewer x:Name="rxlog"/>
                </GroupBox>
            </Grid>

        </Grid>
    </ScrollViewer>
</UserControl>