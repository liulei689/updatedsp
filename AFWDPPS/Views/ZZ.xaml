<UserControl x:Class="AFWDPP.Views.ZZ"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rubyer="http://rubyer.io/winfx/xaml/toolkit"
             xmlns:viewmodels="clr-namespace:AFWDPP.ViewModels" xmlns:usercontrols="clr-namespace:导引头上位机程序.Views.UserControls"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible">
        <Grid Margin="5" 
                  rubyer:GridHelper.RowDefinitions="Auto,Auto, Auto,*"
                  rubyer:PanelHelper.Spacing="10" VerticalAlignment="Stretch">
            <GroupBox Grid.Row="0" Header="模拟追踪平台-操作区域"  >
                <Grid  rubyer:GridHelper.RowDefinitions="Auto, Auto,Auto,Auto,*">
                    <Grid  rubyer:GridHelper.ColumnDefinitions="Auto,*, Auto,Auto,Auto,Auto,Auto" Grid.Row="0" Margin="5">
                        <TextBlock Grid.Column="0"  Text="串口号:"  />
                        <ComboBox Grid.Column="1" Name="comlist"  Margin="20 0"  SelectionChanged="comlist_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="波特率:"  />
                        <ComboBox Grid.Column="3" Name="botelv" Width="100" Margin="20 0" />
                        <ToggleButton Grid.Column="4" x:Name="openclosecom" Style="{DynamicResource SwitchToggleButton}" Margin="10 0" IsChecked="False" Click="openclosecom_Click">
                            <StackPanel Orientation="Horizontal">
                                <rubyer:Icon Type="WifiOffFill" />
                                <TextBlock Margin="5 0 0 0" Text="串口未连接" />
                            </StackPanel>
                            <rubyer:ToggleButtonHelper.CheckedContent>
                                <StackPanel Orientation="Horizontal">
                                    <rubyer:Icon Type="WifiFill" Foreground="{StaticResource Success}" />
                                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource Success}" Text="串口已连接" />
                                </StackPanel>
                            </rubyer:ToggleButtonHelper.CheckedContent>
                        </ToggleButton>
                        <rubyer:Loading Grid.Column="5" Name="rx" Style="{StaticResource WaveLoading}" Margin="20 0"   FontSize="8" Content="接收" IsEnabled="False"/>
                        <rubyer:Loading Grid.Column="6" Name="tx" Style="{StaticResource WaveLoading}" Margin="20 0" FocusedBrush="{DynamicResource Success}" FontSize="8" Content="发送" IsEnabled="False"/>

                    </Grid>
                    <rubyer:Description Style="{StaticResource BorderDescription}" Name="allsenddata"
                               Grid.Row="3"                                        
                               Margin="1"
                               Columns="4">
                        <rubyer:DescriptionItem  Description="【5】帧计数"  >
                            <TextBox x:Name="IDC_EDIT_FC_5"  Text="0" Tag="Hex" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【6~7】版本号整数"  >
                            <TextBox x:Name="IDC_EDIT_FC_6_7"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【8~9】版本号小数"  >
                            <TextBox x:Name="IDC_EDIT_FC_8_9"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【10~11】水平视场uint16_t(单位0.1度)"  >
                            <TextBox x:Name="IDC_EDIT_FC_10_11"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【12~13】垂直视场uint16_t(单位0.1度)" >
                            <TextBox x:Name="IDC_EDIT_FC_12_13"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【14】电子变倍uint8_t(单位0.1)" >
                            <TextBox x:Name="IDC_EDIT_FC_14"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【15】可见光模块状态字" >
                            <TextBox x:Name="IDC_EDIT_FC_15"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【16】红外模块状态字（无）" >
                            <TextBox x:Name="IDC_EDIT_FC_16"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【17】激光测距模块状态字（无）" >
                            <TextBox x:Name="IDC_EDIT_FC_17"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【18】跟踪模块状态字；（跟踪）" >
                            <TextBox x:Name="IDC_EDIT_FC_18"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【19】可见光故障字反馈；（跟踪" >
                            <TextBox x:Name="IDC_EDIT_FC_19"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【20】跟踪模块故障字反馈；（跟踪）" >
                            <TextBox x:Name="IDC_EDIT_FC_20"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【21】测偏量有效标志" >
                            <TextBox x:Name="IDC_EDIT_FC_21"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【22~23】int16_t左右偏差(单位0.1个像素)" >
                            <TextBox x:Name="IDC_EDIT_FC_22_23"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【24~25】int16_t高低偏差(单位0.1个像素)" >
                            <TextBox x:Name="IDC_EDIT_FC_24_25"  Text="90"  />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【26】激光数据有效标志" >
                            <TextBox x:Name="IDC_EDIT_FC_26"  Text="90" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【27~30】目标距离float数据；（无）" >
                            <TextBox x:Name="IDC_EDIT_FC_27_30"  Text="90"  />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="【31】识别到的目标数N" >
                            <TextBox x:Name="IDC_EDIT_FC_31"  Text="01" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="开启接发数据显示"  >
                            <ToggleButton  x:Name="rxtxshow" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="False" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="自动发送"  >
                            <StackPanel Orientation="Horizontal" >
                                <ToggleButton  x:Name="sendermodel" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="False" />
                                <Button Style="{StaticResource TextButton}" Width="80" Content="发送" rubyer:ButtonHelper.Shape="Circle" Cursor="Hand" Click="Button_Click">

                                </Button>
                            </StackPanel>
                        </rubyer:DescriptionItem>
                    </rubyer:Description>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="接受数据解析">
                <StackPanel Orientation="Vertical">
                    <Label Content="1、透雾" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
             Margin="1"
             Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_1"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_1_5"       Description="【5】0x00关0x01开" />
                    </rubyer:Description>
                    <Label Content="2、变焦" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
             Margin="1"
             Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_2"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_2_5"       Description="【5】0x01（变焦+）0x02（变焦-）0x00（变焦停）0x03（小步进+）0x04（小步进-）0x05（大步进+）0x06（大步进-）" />
                    </rubyer:Description>
                    <Label Content="3、可见光电子放大" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
                    Margin="1"
                    Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_3"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_3_5"       Description="【5】放大数值" />
                    </rubyer:Description>
                    <Label Content="4、调焦" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_4"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_4_5"       Description="【5】0x00（调焦停）0x01（调焦+）0x02（调焦-）0x03（小步进+）0x04（小步进-）0x05（大步进+）0x06（大步进-）" />
                    </rubyer:Description>
                    <Label Content="5、设置焦位"  />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_5"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_5_5"       Description="【5】数据" />
                    </rubyer:Description>
                    <Label Content="6、焦位变化" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_6"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_6_5"       Description="【5】0x01焦位+ 0x02焦位-" />
                    </rubyer:Description>
                    <Label Content="7、自动对焦(单次)" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_7"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_7_5"       Description="【5】数据" />
                    </rubyer:Description>
                    <Label Content="8、测距开关" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_8"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_8_5"       Description="【5】0x00连续停止0x01连续开始0x02单次测距" />
                    </rubyer:Description>
                    <Label Content="9、测距设置" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_9"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_9_5"       Description="【5】0xXX频率数，Hz" />
                    </rubyer:Description>
                    <Label Content="10、视频切换" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_10"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_10_5"       Description="【5】0x00 可见光0x01红外0x02可见光1" />
                    </rubyer:Description>
                    <Label Content="11、波门引导控制" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="7">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11_3"       Description="【3】帧类型" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11_5"       Description="【5】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11_6"       Description="【6】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11_7"       Description="【7】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11_8"       Description="【8】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11_9"       Description="【9】数据" />

                    </rubyer:Description>
                    <Label Content="12、跟踪方式" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_12"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_12_5"       Description="【5】0x00质心0x01相关" />
                    </rubyer:Description>
                    <Label Content="13、质心跟踪目标特性" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_13"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_13_5"       Description="【5】0x00黑目标0x01白目标" />
                    </rubyer:Description>
                    <Label Content="14、识别开关" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_14"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_14_5"       Description="【5】0x00识别关0x01识别开" />
                    </rubyer:Description>
                    <Label Content="15、波门大小设置" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="7">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15_5"       Description="【5】D5：0x00精确设置；0x01快捷设置；" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15_6"       Description="【6】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15_7"       Description="【7】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15_8"       Description="【8】数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15_9"       Description="【9】数据" />
                    </rubyer:Description>
                    <Label Content="16、波门移动" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
            Margin="1"
            Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_16"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_16_5"       Description="【5】D5：0x00无动作，0x01上，0x02下， 0x03左，0x04右；D6：移动的像素数量0~10" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_16_6"       Description="【6】D6：移动的像素数量0~10" />

                    </rubyer:Description>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="数据显示" >
                <Grid  Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- 第二个TextBlock的列宽 -->
                        <ColumnDefinition Width="*"/>
                        <!-- 第二个TextBox的列宽，自适应剩余空间 -->
                    </Grid.ColumnDefinitions>
                    <usercontrols:RunDataListViewer Margin="2" Grid.Column="0" x:Name="txlog"   />
                    <usercontrols:RunDataListViewer Margin="2" Grid.Column="1"   x:Name="rxlog"   />


                </Grid>

            </GroupBox>
            <StatusBar  Grid.Row="3" Background="#0F000000" DockPanel.Dock="Bottom" VerticalAlignment="Bottom"  >
                <StatusBarItem HorizontalAlignment="Left">
                    <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_2" Cursor="Hand">
                        <rubyer:Icon Type="TerminalBoxLine" Foreground="{DynamicResource Primary}" />
                    </Button>
                </StatusBarItem>
                <Separator />
                <StatusBarItem HorizontalAlignment="Left" Content="就绪" />
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_3" Cursor="Hand">
                            <rubyer:Icon Margin="5 0" Type="UploadLine"  Foreground="{DynamicResource Primary}"/>
                        </Button>
                        <TextBlock Name="timenow" Margin="5 0" Text="" />
                        <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_4"  Cursor="Hand">
                            <rubyer:Icon Margin="5 0" Type="Notification3Fill" Foreground="{DynamicResource Primary}"/>
                        </Button>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

        </Grid>
    </ScrollViewer>
</UserControl>
