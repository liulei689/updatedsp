<UserControl x:Class="AFWDPP.Views.FC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rubyer="http://rubyer.io/winfx/xaml/toolkit"
             xmlns:viewmodels="clr-namespace:AFWDPP.ViewModels" xmlns:usercontrols="clr-namespace:导引头上位机程序.Views.UserControls"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
        <Grid Margin="5" 
                  rubyer:GridHelper.RowDefinitions="Auto,Auto, Auto,*"
                  rubyer:PanelHelper.Spacing="10" VerticalAlignment="Stretch">
            <GroupBox Grid.Row="0" Header="模拟飞空平台-操作区域"  >
                <Grid  rubyer:GridHelper.RowDefinitions="Auto, Auto,Auto,Auto,*">
                    <Grid  rubyer:GridHelper.ColumnDefinitions="Auto,*, Auto,Auto,Auto,Auto,Auto" Grid.Row="0" Margin="5">
                        <TextBlock Grid.Column="0"  Text="串口号:"  />
                        <ComboBox Grid.Column="1" Name="comlist"  Margin="20 0"  SelectionChanged="comlist_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="波特率:"  />
                        <ComboBox Grid.Column="3" Name="botelv" Width="100" Margin="20 0" />
                        <ToggleButton Grid.Column="4" x:Name="openclosecom" Style="{DynamicResource SwitchToggleButton}" Margin="10 0" IsChecked="False" Click="openclosecom_Click">
                            <StackPanel Orientation="Horizontal">
                                <rubyer:Icon Type="WifiOffFill" />
                                <TextBlock Margin="5 0 0 0" Text="串口未连接" />
                            </StackPanel>
                            <rubyer:ToggleButtonHelper.CheckedContent>
                                <StackPanel Orientation="Horizontal">
                                    <rubyer:Icon Type="WifiFill" Foreground="{StaticResource Success}" />
                                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource Success}" Text="串口已连接" />
                                </StackPanel>
                            </rubyer:ToggleButtonHelper.CheckedContent>
                        </ToggleButton>
                        <rubyer:Loading Grid.Column="5" Name="rx" Style="{StaticResource WaveLoading}" Margin="20 0"   FontSize="8" Content="接收" IsEnabled="False"/>
                        <rubyer:Loading Grid.Column="6" Name="tx" Style="{StaticResource WaveLoading}" Margin="20 0" FocusedBrush="{DynamicResource Success}" FontSize="8" Content="发送" IsEnabled="False"/>

                    </Grid>
                    <rubyer:Description Style="{StaticResource BorderDescription}" Name="allsenddata"
                               Grid.Row="3"                                        
                               Margin="1"
                               Columns="4">
                        <rubyer:DescriptionItem  Description="模块"  >
                            <ComboBox x:Name="IDC_EDIT_FC_1" MinWidth="100"  Text="90" SelectedIndex="0" SelectionChanged="IDC_EDIT_FC_1_SelectionChanged"/>
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="功能"  >
                            <ComboBox x:Name="IDC_EDIT_FC_2"  Text="90" SelectedIndex="0" SelectionChanged="IDC_EDIT_FC_2_SelectionChanged"/>
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="开启心跳"  >
                            <ToggleButton  x:Name="headhe" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="True" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="开启接发数据显示"  >
                            <ToggleButton  x:Name="rxtxshow" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="False" />
                        </rubyer:DescriptionItem>
                        <!--<rubyer:DescriptionItem  Description="方向"  x:Name="IDC_EDIT_FC_3"  />-->
                        <rubyer:DescriptionItem  Description="备注"   x:Name="IDC_EDIT_FC_4" />
                        <rubyer:DescriptionItem  Description="数据"   >
                            <StackPanel Orientation="Horizontal" Name="IDC_EDIT_FC_5">  </StackPanel>
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="数据详情"   x:Name="IDC_EDIT_FC_6" />
                        <rubyer:DescriptionItem  Description="自动发送"  >
                            <StackPanel Orientation="Horizontal" >
                                <ToggleButton  x:Name="sendermodel" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="True" />
                                <Button Style="{StaticResource TextButton}" Width="80" Content="发送" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click"  Cursor="Hand">
                                
                                </Button>
                            </StackPanel>
                        </rubyer:DescriptionItem>
                    </rubyer:Description>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="接受数据解析">
                <StackPanel Orientation="Vertical">
                    <Label Content="38、自动漂移反馈" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
                        Margin="1"
                        Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKB_0"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKB_1"       Description="【5~6】漂移状态字" />
                    </rubyer:Description>
                    <Label Content="40、读取保存状态" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
                        Margin="1"
                        Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKB_2"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKB_3"       Description="【5~6】读取保存状态" />
                    </rubyer:Description>
                    <Label Content="41、心跳反馈帧解析" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
                               Margin="1"
                               Columns="2">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_0"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_1"       Description="【5~6】版本号" />
                    </rubyer:Description>
                    <Label Content="43、光电数据" />
                    <rubyer:Description Style="{StaticResource BorderDescription}" Margin="1" Columns="3">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_13"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_2"       Description="【5~8】方位角" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_3"       Description="【9~12】俯仰角" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_4"       Description="【13~16】陀螺俯仰角速度float数据(伺服)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_5"       Description="【17~20】陀螺方位角速度float数据(伺服)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_6"       Description="【21~24】测角方位角速度float数据(伺服)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_7"       Description="【25~28】测角俯仰角速度float数据(伺服)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_8"       Description="【29】测偏量有效标志0x00无效，0x01有效（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_9"       Description="【30~31】int16_t左右偏差(单位0.1个像素)（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_10"       Description="【32~33】int16_t高低偏差(单位0.1个像素)（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_11"       Description="【34】目标距离float数据" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_12"       Description="【35~38】目标距离float数据" />
                    </rubyer:Description>
                    <Label Content="44、光电信息" />
                    <rubyer:Description Style="{StaticResource BorderDescription}" Margin="1" Columns="3">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_14"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_15"       Description="【5~6】水平视场uint16_t(单位0.1度)(跟踪)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_16"       Description="【7~8】垂直视场uint16_t(单位0.1度)(跟踪)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_17"       Description="【9】电子变倍uint8_t(单位0.1)；（跟踪)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_18"       Description="【10】可见光模块状态字；（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_19"       Description="【11】红外模块状态字；（无）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_20"       Description="【12】激光测距模块状态字；（无)" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_21"       Description="【13】跟踪模块状态字；（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_22"       Description="【14】伺服模块状态字；（伺服）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_23"       Description="【15】其他功能状态字"/>
                    </rubyer:Description>
                    <Label Content="45、故障码" />
                    <rubyer:Description Style="{StaticResource BorderDescription}" Margin="1" Columns="3">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_31"       Description="接受帧数" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_24"       Description="【5】可见光故障字反馈；（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_25"       Description="【6】红外故障字反馈；（无）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_26"       Description="【7】激光故障字反馈；（无）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_27"       Description="【8】跟踪模块故障字反馈；（跟踪）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_28"       Description="【9】伺服模块故障字反馈；（伺服）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_29"       Description="【10】陀螺故障字反馈；（伺服）" />
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_30"       Description="【11】参数装调反馈；（伺服）" />
                    </rubyer:Description>
                    <Label Content="45、识别物体" />
                    <rubyer:Description Style="{StaticResource BorderDescription}" Margin="1" Columns="3">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_32"       Description="【0】接受帧数" />
                        
                    </rubyer:Description>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="数据显示" >
                <Grid  Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- 第二个TextBlock的列宽 -->
                        <ColumnDefinition Width="*"/>
                        <!-- 第二个TextBox的列宽，自适应剩余空间 -->
                    </Grid.ColumnDefinitions>
                    <usercontrols:RunDataListViewer Margin="2" Grid.Column="0"  x:Name="txlog"   />
                    <usercontrols:RunDataListViewer Margin="2" Grid.Column="1"    x:Name="rxlog"   />


                </Grid>

            </GroupBox>
            <StatusBar  Grid.Row="3" Background="#0F000000" DockPanel.Dock="Bottom" VerticalAlignment="Bottom"  >
                    <StatusBarItem HorizontalAlignment="Left">
                    <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_2" Cursor="Hand">
                        <rubyer:Icon Type="TerminalBoxLine" Foreground="{DynamicResource Primary}" />
                    </Button>
                </StatusBarItem>
                    <Separator />
                    <StatusBarItem HorizontalAlignment="Left" Content="就绪" />
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_3" Cursor="Hand">
                            <rubyer:Icon Margin="5 0" Type="UploadLine"  Foreground="{DynamicResource Primary}"/>
                        </Button>
                        <TextBlock Name="timenow" Margin="5 0" Text="" />
                        <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_4"  Cursor="Hand">
                            <rubyer:Icon Margin="5 0" Type="Notification3Fill" Foreground="{DynamicResource Primary}"/>
                        </Button>
                    </StackPanel>
                    </StatusBarItem>
                </StatusBar>
         
        </Grid>
    </ScrollViewer>
</UserControl>
