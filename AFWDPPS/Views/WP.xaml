<UserControl x:Class="AFWDPP.Views.WP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rubyer="http://rubyer.io/winfx/xaml/toolkit"
             xmlns:viewmodels="clr-namespace:AFWDPP.ViewModels" xmlns:usercontrols="clr-namespace:导引头上位机程序.Views.UserControls"
             mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
        <Grid Margin="5" 
                  rubyer:GridHelper.RowDefinitions="Auto,Auto, Auto,*"
                  rubyer:PanelHelper.Spacing="10" VerticalAlignment="Stretch">
            <GroupBox Grid.Row="0" Header="模拟水下平台上位机-操作区域"  >
                <Grid  rubyer:GridHelper.RowDefinitions="Auto, Auto,Auto,Auto,*">
                    <Grid  rubyer:GridHelper.ColumnDefinitions="Auto,*, Auto,Auto,Auto,Auto,Auto" Grid.Row="0" Margin="5">
                        <TextBlock Grid.Column="0"  Text="串口号:"  />
                        <ComboBox Grid.Column="1" Name="comlist"  Margin="20 0"  SelectionChanged="comlist_SelectionChanged"/>
                        <TextBlock Grid.Column="2" Text="波特率:"  />
                        <ComboBox Grid.Column="3" Name="botelv" Width="100" Margin="20 0" />
                        <ToggleButton Grid.Column="4" x:Name="openclosecom" Style="{DynamicResource SwitchToggleButton}" Margin="10 0" IsChecked="False" Click="openclosecom_Click">
                            <StackPanel Orientation="Horizontal">
                                <rubyer:Icon Type="WifiOffFill" />
                                <TextBlock Margin="5 0 0 0" Text="串口未连接" />
                            </StackPanel>
                            <rubyer:ToggleButtonHelper.CheckedContent>
                                <StackPanel Orientation="Horizontal">
                                    <rubyer:Icon Type="WifiFill" Foreground="{StaticResource Success}" />
                                    <TextBlock Margin="5 0 0 0" Foreground="{StaticResource Success}" Text="串口已连接" />
                                </StackPanel>
                            </rubyer:ToggleButtonHelper.CheckedContent>
                        </ToggleButton>
                        <rubyer:Loading Grid.Column="5" Name="rx" Style="{StaticResource WaveLoading}" Margin="20 0"   FontSize="8" Content="接收" IsEnabled="False"/>
                        <rubyer:Loading Grid.Column="6" Name="tx" Style="{StaticResource WaveLoading}" Margin="20 0" FocusedBrush="{DynamicResource Success}" FontSize="8" Content="发送" IsEnabled="False"/>

                    </Grid>
                    <rubyer:Description Style="{StaticResource BorderDescription}" Name="allsenddata"
                               Grid.Row="3"                                        
                               Margin="1"
                               Columns="1">
                        <rubyer:DescriptionItem  Description="开启接发数据显示"  >
                            <ToggleButton  x:Name="rxtxshow" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="True" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="滚转角度"   >
                            <rubyer:NumericBox x:Name="x1" Interval="5" MinValue="-30.5" MaxValue="30.5" rubyer:InputBoxHelper.PostContent="°" Style="{StaticResource FrontBackNumericBox}" MinWidth="120" Value="0" NumericType="Double" Cursor="IBeam" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="俯仰角度"   >
                            <rubyer:NumericBox x:Name="y1" Interval="5" MinValue="-30.5" MaxValue="30.5" rubyer:InputBoxHelper.PostContent="°" Style="{StaticResource FrontBackNumericBox}" MinWidth="120" Value="0" NumericType="Double" Cursor="IBeam" />
                        </rubyer:DescriptionItem>
                        <rubyer:DescriptionItem  Description="模式"  >
                            <TabControl x:Name="searchtime" SelectionChanged="searchtime_SelectionChanged"   Style="{StaticResource LineTabControl}">
                                <TabItem Header="稳定状态" IsSelected="True" />
                                <TabItem Header="锁定状态" />
                                <TabItem Header="机械校零" />
                                <TabItem Header="前置声呐控制" />
                                <TabItem Header="自检" />
                                <TabItem Header="陀螺校零" />
                            </TabControl>

                        </rubyer:DescriptionItem>

                        <rubyer:DescriptionItem  Description="操作"  >
                            <StackPanel Orientation="Horizontal" >
                                <ToggleButton  x:Name="sendermodel" Style="{DynamicResource SwitchToggleButton}" Margin="0" IsChecked="False"  Visibility="Collapsed"/>
                                <Button Name="cmd"  Style="{StaticResource TextButton}" Width="80" Content="发送指令" rubyer:ButtonHelper.Shape="Circle"  Click="Button_Click" Cursor="Hand">
                                </Button>
                                <Button Name="l1" Style="{StaticResource TextButton}" Width="80" Content="向上" Visibility="Collapsed" rubyer:ButtonHelper.Shape="Circle"  PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"  PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"  Cursor="Hand">
                                </Button>
                                <Button Name="l2" Style="{StaticResource TextButton}" Width="80" Content="向下" Visibility="Collapsed" rubyer:ButtonHelper.Shape="Circle" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"  PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" Cursor="Hand">
                                </Button>
                                <Button Name="l3" Style="{StaticResource TextButton}" Width="80" Content="向左" Visibility="Collapsed" rubyer:ButtonHelper.Shape="Circle" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"  PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown" Cursor="Hand">
                                </Button>
                                <Button Name="l4" Style="{StaticResource TextButton}" Width="80" Content="向右" Visibility="Collapsed"  rubyer:ButtonHelper.Shape="Circle" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"  PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"  Cursor="Hand">
                                </Button>
                                <Button Name="t1" Style="{StaticResource TextButton}" Width="80" Content="自动校准零漂" Visibility="Collapsed"  rubyer:ButtonHelper.Shape="Circle"  Click="t1_Click"  Cursor="Hand">
                                </Button>
                                <Button Name="t2" Style="{StaticResource TextButton}" Width="80" Content="横摇正向校漂" Visibility="Collapsed"  rubyer:ButtonHelper.Shape="Circle" Click="t1_Click"    Cursor="Hand">
                                </Button>
                                <Button Name="t3" Style="{StaticResource TextButton}" Width="80" Content="横摇负向校漂" Visibility="Collapsed"  rubyer:ButtonHelper.Shape="Circle" Click="t1_Click"   Cursor="Hand">
                                </Button>
                                <Button Name="t4" Style="{StaticResource TextButton}" Width="80" Content="纵倾正向校漂" Visibility="Collapsed"  rubyer:ButtonHelper.Shape="Circle" Click="t1_Click"    Cursor="Hand">
                                </Button>
                                <Button Name="t5" Style="{StaticResource TextButton}" Width="80" Content="纵倾负向校漂" Visibility="Collapsed"  rubyer:ButtonHelper.Shape="Circle" Click="t1_Click"    Cursor="Hand">
                                </Button>
                                <Button Name="l7" Visibility="Collapsed" Style="{StaticResource TextButton}" Width="80" Content="开始自检" rubyer:ButtonHelper.Shape="Circle" PreviewMouseLeftButtonUp="l7_PreviewMouseLeftButtonUp"   Cursor="Hand">
                                </Button>
                                <Label Name="status" Visibility="Collapsed" />

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical" Margin="20">
                                        <Button Name="l5" Visibility="Collapsed" Style="{StaticResource TextButton}" Width="80" Content="开始下发" rubyer:ButtonHelper.Shape="Circle" PreviewMouseLeftButtonUp="l5_PreviewMouseLeftButtonUp_1"   Cursor="Hand">
                                        </Button>
                                       
                                    </StackPanel>
                                    <StackPanel Margin="20" Orientation="Vertical" x:Name="l3m" Visibility="Collapsed">
                                        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold"
               Text="{Binding Value, ElementName=slider, StringFormat={}{0:F0}°}"/>
                                        <Slider x:Name="slider" AutoToolTipPlacement="BottomRight" IsEnabled="False"
            Minimum="0" Maximum="30" Value="10" Width="250"  rubyer:SliderHelper.GripDiameter="15"   rubyer:SliderHelper.TrackThickness="10"
            TickFrequency="1"
            TickPlacement="Both"
            IsSnapToTickEnabled="True"
                                           />

                                        <!-- 每 5 一格：0 5 10 15 20 25 30 -->
                                        <UniformGrid Columns="7" Margin="0,2"
                 Width="{Binding ActualWidth,ElementName=slider}">
                                            <TextBlock Text="0"  HorizontalAlignment="Left" FontSize="10"/>
                                            <TextBlock Text="5"  HorizontalAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="10" HorizontalAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="15" HorizontalAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="20" HorizontalAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="25" HorizontalAlignment="Center" FontSize="10"/>
                                            <TextBlock Text="30" HorizontalAlignment="Right" FontSize="10"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </rubyer:DescriptionItem>
                    </rubyer:Description>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="接受数据解析">
                <StackPanel Orientation="Vertical">
                    <Label Content="DSP回传数据" />
                    <rubyer:Description Style="{StaticResource BorderDescription}"
                        Margin="1" HorizontalAlignment="Left"
                        Columns="3">
                        <rubyer:DescriptionItem Name="IDC_EDIT_CHECKA_0_0"   Width="200"    Description="接受帧数" />
                        <rubyer:DescriptionItem Name="x2"    Width="200"     Description="方位角度" />
                        <rubyer:DescriptionItem Name="y2"  MinWidth="220"     Description="俯仰角度" />
                        <rubyer:DescriptionItem Name="F3"   Width="200"      Description="陀螺横摇角速度" />
                        <rubyer:DescriptionItem Name="F4"    Width="200"     Description="陀螺俯仰角速度" />
                        <rubyer:DescriptionItem Name="F5"   MinWidth="220"     Description="陀螺横摇角速度积分" />
                        <rubyer:DescriptionItem Name="F6"    Width="200"     Description="陀螺俯仰角速度积分" />
                        <rubyer:DescriptionItem Name="F7"   Width="200"      Description="横摇电流" />
                        <rubyer:DescriptionItem Name="F8"  MinWidth="220"      Description="俯仰电流" />
                        <rubyer:DescriptionItem Name="U9"  Width="200"       Description="预留" />
                        <rubyer:DescriptionItem Name="s3"    Width="200"     Description="状态" />
                    </rubyer:Description>
                    <rubyer:Description Style="{StaticResource BorderDescription}" Margin="1" Columns="1">
                            <rubyer:DescriptionItem Name="U9D" Description="预留位解析" />
                        </rubyer:Description>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="数据显示" >
                <Grid  Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- 第二个TextBlock的列宽 -->
                        <ColumnDefinition Width="*"/>
                        <!-- 第二个TextBox的列宽，自适应剩余空间 -->
                    </Grid.ColumnDefinitions>
                    <usercontrols:RunDataListViewer Margin="2" Grid.Column="0"  x:Name="txlog"   />
                    <usercontrols:RunDataListViewer Margin="2" Grid.Column="1"    x:Name="rxlog"   />


                </Grid>

            </GroupBox>
            <StatusBar  Grid.Row="3" Background="#0F000000" DockPanel.Dock="Bottom" VerticalAlignment="Bottom"  >
                    <StatusBarItem HorizontalAlignment="Left">
                    <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_2" Cursor="Hand">
                        <rubyer:Icon Type="TerminalBoxLine" Foreground="{DynamicResource Primary}" />
                    </Button>
                </StatusBarItem>
                    <Separator />
                    <StatusBarItem HorizontalAlignment="Left" Content="就绪" />
                    <StatusBarItem HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_3" Cursor="Hand">
                            <rubyer:Icon Margin="5 0" Type="UploadLine"  Foreground="{DynamicResource Primary}"/>
                        </Button>
                        <TextBlock Name="timenow" Margin="5 0" Text="" />
                        <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle" Click="Button_Click_4"  Cursor="Hand">
                            <rubyer:Icon Margin="5 0" Type="Notification3Fill" Foreground="{DynamicResource Primary}"/>
                        </Button>
                    </StackPanel>
                    </StatusBarItem>
                </StatusBar>
         
        </Grid>
    </ScrollViewer>
</UserControl>
