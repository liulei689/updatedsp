<UserControl x:Class="UpdateDSP.Views.UpdateDspNormal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rubyer="http://rubyer.io/winfx/xaml/toolkit"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             xmlns:viewmodels="clr-namespace:UpdateDSP.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:DescriptionViewModel}"
             mc:Ignorable="d">
    <smtx:XamlDisplay UniqueKey="UpdateDspNormal">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="10"
                  rubyer:GridHelper.RowDefinitions="Auto, Auto"
                  rubyer:PanelHelper.Spacing="10" VerticalAlignment="Top">
                <GroupBox Grid.Row="0" Header="操作区域" >
                    <Grid rubyer:GridHelper.RowDefinitions="Auto, Auto">
                        <StackPanel Orientation="Horizontal"  Grid.Row="0" Margin="5">
                            <TextBlock Style="{StaticResource Head4TextBlock}" Text="打开串口:"  />
                            <ComboBox Width="250" Margin="20 0" />
                            <ToggleButton Style="{DynamicResource SwitchToggleButton}" Margin="10 0" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <rubyer:Icon Type="WifiOffFill" />
                                    <TextBlock Margin="5 0 0 0" Text="串口未连接" />
                                </StackPanel>
                                <rubyer:ToggleButtonHelper.CheckedContent>
                                    <StackPanel Orientation="Horizontal">
                                        <rubyer:Icon Type="WifiFill" Foreground="{StaticResource Success}" />
                                        <TextBlock Margin="5 0 0 0" Foreground="{StaticResource Success}" Text="串口已连接" />
                                    </StackPanel>
                                </rubyer:ToggleButtonHelper.CheckedContent>
                            </ToggleButton>
                        </StackPanel>
                        <Grid Grid.Row="1" rubyer:GridHelper.ColumnDefinitions="Auto, Auto, *" Margin="5">
                            <TextBlock  Grid.Column="0" Style="{StaticResource Head4TextBlock}" Text="打开固件:" />
                            <Button Grid.Column="1" Foreground="#FB8C00" Background="Transparent" ToolTip="打开固件(Ctrl+O)"/>
                            <TextBox Grid.Column="2"  IsHitTestVisible="True"  IsEnabled="True" MouseLeftButtonDown="TextBox_MouseLeftButtonDown">
                                <rubyer:InputBoxHelper.PostContent>
                                    <Button Style="{StaticResource TextButton}" rubyer:ButtonHelper.Shape="Circle">
                                        <rubyer:Icon Type="FolderOpenFill" />
                                    </Button>
                                </rubyer:InputBoxHelper.PostContent>
                            </TextBox>
                        </Grid>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="带边框 - BorderDescription">
                    <Grid rubyer:GridHelper.RowDefinitions="Auto, Auto, Auto, Auto">
                        <TextBlock Grid.Row="0" Style="{StaticResource Head4TextBlock}" Text="DescriptionItem 方式:" />
                        <rubyer:Description Style="{StaticResource BorderDescription}"
                                            Grid.Row="1"
                                            Margin="10"
                                            Columns="{Binding CurrentColumn}">
                            <rubyer:DescriptionItem Content="Columns" Description="列数" />
                            <rubyer:DescriptionItem Content="HorizontalDescriptionAlignment" Description="水平对齐" />
                            <rubyer:DescriptionItem Content="VerticalDescriptionAlignment" Description="垂直对齐" />
                            <rubyer:DescriptionItem Content="DescriptionFontSize" Description="字体大小" />
                            <rubyer:DescriptionItem Description="其他">
                                <rubyer:DescriptionItem.Content>
                                    <TextBlock TextWrapping="Wrap">DescriptionFontWeight, DescriptionBackground, DescriptionForeground, DisplayDescriptionPath, DescriptionStringFormat</TextBlock>
                                </rubyer:DescriptionItem.Content>
                            </rubyer:DescriptionItem>
                        </rubyer:Description>

                        <TextBlock Style="{StaticResource Head4TextBlock}"
                                   Grid.Row="2"
                                   Text="DescriptionItem 方式:" />

                        <rubyer:Description Style="{StaticResource BorderDescription}"
                                            Grid.Row="3"
                                            Margin="10"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Background="{DynamicResource Light}"
                                            BorderThickness="3"
                                            Columns="{Binding CurrentColumn}"
                                            DescriptionBackground="{DynamicResource Dark}"
                                            DescriptionFontSize="14"
                                            DescriptionFontWeight="Bold"
                                            DescriptionForeground="{DynamicResource WhiteForeground}"
                                            DisplayDescriptionPath="Description"
                                            DisplayMemberPath="Content"
                                            HorizontalDescriptionAlignment="Center"
                                            ItemsSource="{Binding Models}" />
                    </Grid>
                </GroupBox>
        
            </Grid>
        </ScrollViewer>
    </smtx:XamlDisplay>
</UserControl>
