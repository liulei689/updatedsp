<UserControl x:Class="UpdateDSP.Views.About"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:rubyer="http://rubyer.io/winfx/xaml/toolkit"
             mc:Ignorable="d">
    <Grid Margin="50 10 50 30" rubyer:GridHelper.RowDefinitions="Auto, *">
        <Grid HorizontalAlignment="Center" rubyer:GridHelper.ColumnDefinitions="Auto, *">
            <Image Grid.Column="0"
                   Width="50"
                   VerticalAlignment="Center"
                   Source="../rubyer.ico" />
            <StackPanel Grid.Column="1" Margin="20 0">
                <StackPanel Margin="0 0 0 5" Orientation="Horizontal">
                    <TextBlock FontSize="20">DSP在线升级模拟上位机</TextBlock>
                    <TextBlock Margin="10 0">作者:昆明光博科技有限公司</TextBlock>
                </StackPanel>

                <TextBlock>
                    版本:<Hyperlink Click="Hyperlink_Click" NavigateUri="">
                        V0.0.0.2
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1"
              Margin="0 10 0 0"
              rubyer:GridHelper.RowDefinitions="*,*, *, *">
    
        </Grid>
   
    </Grid>
</UserControl>